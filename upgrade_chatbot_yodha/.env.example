# =============================================================================
# ChatBotYodha Upgrade — Environment Variables
# =============================================================================
# Copy to .env and fill in your credentials.  NEVER commit .env to git.
# =============================================================================

# ── 1. DATABASE (Azure PostgreSQL or local Docker) ────────────────────
DATABASE_URL=postgresql://chatbotuser:Botuser101@localhost:5432/mycrm

# ── 2. LLM PROVIDER ──────────────────────────────────────────────────
LLM_PROVIDER=openai
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
# Ollama (alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b

# ── 3. EMBEDDING MODEL ───────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_FALLBACK=all-MiniLM-L6-v2

# ── 4. EMAIL (Gmail SMTP with App Password) ──────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_EMAIL=your_gmail@gmail.com

# ── 5. TWILIO (WhatsApp + SMS) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── 6. TELEGRAM BOT ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── 7. AZURE BLOB STORAGE (conversation files) ───────────────────────
STORAGE_BACKEND=local
# Set to "azure" and fill below for production:
AZURE_BLOB_CONNECTION_STRING=your_connection_string
AZURE_BLOB_CONTAINER_NAME=chatbot-sessions

# ── 8. GOOGLE CALENDAR ───────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ── 9. MICROSOFT TEAMS (optional) ────────────────────────────────────
MSAL_CLIENT_ID=your_client_id
MSAL_TENANT_ID=your_tenant_id
MSAL_CLIENT_SECRET=your_secret

# ── 10. APP SETTINGS ─────────────────────────────────────────────────
COMPANY_NAME=Contoso
DEBUG_MODE=false
API_SECRET_KEY=change-me-to-a-random-secret
RATE_LIMIT=60/minute

# ── 11. MEETING DEFAULTS ─────────────────────────────────────────────
DEFAULT_MEETING_DURATION_MINUTES=60
DEFAULT_TIMEZONE=Asia/Kolkata
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17

# ── 12. ORGANIZER (receives copy of meeting notifications) ───────────
ORGANIZER_NAME=Yodha Guy
ORGANIZER_EMAIL=yodhaguy@gmail.com
ORGANIZER_PHONE=+918766776988
