# Ollama Configuration for GPT/OSS Models
# Add these to your .env file or set as environment variables

# Set Ollama as primary LLM (set to false to use Groq as primary)
USE_OLLAMA_PRIMARY=true

# Ollama server configuration
OLLAMA_BASE_URL=http://localhost:11434

# Preferred model (change based on what you have installed)
# Recommended models:
# - llama3.2:1b (small, fast - 1.3GB)
# - llama3.2:3b (medium - 2.0GB) 
# - llama3.1:8b (large - 4.7GB)
# - mistral:7b (alternative - 4.1GB)
# - codellama:7b (code-focused - 3.8GB)
OLLAMA_MODEL=llama3.2:1b

# Keep Groq as backup (optional)
GROQ_API_KEY=your_groq_api_key

# Database configuration (if you have it)
DATABASE_URL=your_database_url
